{
	"name": "better-calendars",
	"version": "1.0.12",
	"description": "Calendar sidebar for Obsidian: create daily notes in advance with a template, and automatically import Google Calendar events as notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint . && tsc -noEmit -skipLibCheck",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"calendar",
		"daily-notes",
		"google-calendar",
		"ics"
	],
	"author": "theshayneb",
	"license": "MIT",
	"dependencies": {
		"ical.js": "^2.2.1"
	},
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "^9.30.1",
		"@types/node": "^22.20.5",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^14.0.0",
		"jiti": "^2.6.1",
		"moment": "^2.29.4",
		"obsidian": "^1.14.4",
		"tslib": "^2.4.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.35.1",
		"vitest": "^3.2.7"
	}
}
